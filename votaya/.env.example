# URL pública (para enlaces, Open Graph y sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Neon, Supabase, RDS…). Si se omite en desarrollo se usa PGlite embebido en .data/
# DATABASE_URL=postgres://user:pass@host:5432/votaya

# Secreto para hashes de códigos e IPs (genera uno con: openssl rand -base64 32)
AUTH_SECRET=cambia-esto

# Emails separados por comas que serán administradores al entrar
ADMIN_EMAILS=admin@voppi.app

# Envío de códigos por email (https://resend.com). Sin clave, en desarrollo el código se muestra en pantalla.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=voppi <hola@voppi.app>

# Ajustes antifraude / estadística
# ANON_VOTE_LIMIT=10       votos anónimos por dispositivo antes de pedir registro
# MIN_SEGMENT_VOTES=20     mínimo de votos para mostrar un desglose por país/edad/género

# Premios canjeables (página /recompensas). Ocultos mientras no haya marcas y bases legales.
# REWARDS_ENABLED=1

# Encuestas iniciales al publicar (solo la primera vez):
#   SEED_MODE=launch  → preguntas a cero votos para el lanzamiento real
#   SEED_DEMO=1       → preguntas con votos ficticios marcados como demostración
# SEED_MODE=launch

# Datos del titular para /aviso-legal (LSSI)
# LEGAL_NAME=Nombre o razón social
# LEGAL_NIF=B00000000
# LEGAL_ADDRESS=Calle, número, CP, ciudad
# LEGAL_EMAIL=hola@voppi.app
# LEGAL_REGISTRY=Registro Mercantil de …, tomo …, folio …, hoja …
